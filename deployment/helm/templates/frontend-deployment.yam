apiVersion: apps/v1
kind: Deployment

metadata:

  name: {{ include "ai-platform.frontend.service" . }}

  namespace: {{ include "ai-platform.namespace" . }}

  labels:

{{ include "ai-platform.labels" . | indent 4 }}

spec:

  replicas: {{ .Values.frontend.replicaCount }}

  revisionHistoryLimit: 10

  strategy:

    type: RollingUpdate

    rollingUpdate:

      maxUnavailable: 25%

      maxSurge: 25%

  selector:

    matchLabels:

{{ include "ai-platform.selectorLabels" . | indent 6 }}

      app.kubernetes.io/component: frontend

  template:

    metadata:

      labels:

{{ include "ai-platform.selectorLabels" . | indent 8 }}

        app.kubernetes.io/component: frontend

{{- with .Values.commonLabels }}

{{ toYaml . | indent 8 }}

{{- end }}

      annotations:

{{ include "ai-platform.annotations" . | indent 8 }}

        checksum/config: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}

    spec:

      serviceAccountName: {{ include "ai-platform.serviceAccountName" . }}

{{- if .Values.global.imagePullSecrets }}

      imagePullSecrets:

{{ toYaml .Values.global.imagePullSecrets | indent 8 }}

{{- end }}

      securityContext:

{{ include "ai-platform.podSecurityContext" . | indent 8 }}

      containers:

        - name: frontend

          image: {{ include "ai-platform.frontend.image" . }}

          imagePullPolicy: IfNotPresent

          ports:

            - name: http

              containerPort: 3000

              protocol: TCP

          envFrom:

            - configMapRef:

                name: {{ include "ai-platform.fullname" . }}-frontend

            - secretRef:

                name: {{ include "ai-platform.secretName" . }}
          env:

            - name: NODE_ENV

              value: "production"

            - name: HOSTNAME

              value: "0.0.0.0"

            - name: PORT

              value: "3000"

            - name: POD_NAME

              valueFrom:

                fieldRef:

                  fieldPath: metadata.name

            - name: POD_NAMESPACE

              valueFrom:

                fieldRef:

                  fieldPath: metadata.namespace

            - name: NODE_NAME

              valueFrom:

                fieldRef:

                  fieldPath: spec.nodeName

            - name: POD_IP

              valueFrom:

                fieldRef:

                  fieldPath: status.podIP

{{ include "ai-platform.env" . | indent 12 }}

          resources:

            requests:

              cpu: {{ .Values.frontend.resources.requests.cpu }}

              memory: {{ .Values.frontend.resources.requests.memory }}

            limits:

              cpu: {{ .Values.frontend.resources.limits.cpu }}

              memory: {{ .Values.frontend.resources.limits.memory }}

          securityContext:

{{ include "ai-platform.containerSecurityContext" . | indent 12 }}

          volumeMounts:

            - name: frontend-config

              mountPath: /app/config

              readOnly: true

            - name: frontend-secrets

              mountPath: /app/secrets

              readOnly: true

            - name: next-cache

              mountPath: /app/.next/cache

            - name: static-cache

              mountPath: /app/public/cache

            - name: logs

              mountPath: /var/log/frontend

      volumes:

        - name: frontend-config

          configMap:

            name: {{ include "ai-platform.fullname" . }}-frontend

        - name: frontend-secrets

          secret:

            secretName: {{ include "ai-platform.secretName" . }}

        - name: next-cache

          emptyDir:

            sizeLimit: 2Gi

        - name: static-cache

          emptyDir:

            sizeLimit: 1Gi

        - name: logs

          emptyDir:

            sizeLimit: 1Gi
          livenessProbe:

            httpGet:

              path: /

              port: http

            initialDelaySeconds: 30

            periodSeconds: 15

            timeoutSeconds: 5

            failureThreshold: 3

          readinessProbe:

            httpGet:

              path: /

              port: http

            initialDelaySeconds: 10

            periodSeconds: 10

            timeoutSeconds: 5

            failureThreshold: 3

          startupProbe:

            httpGet:

              path: /

              port: http

            initialDelaySeconds: 5

            periodSeconds: 10

            timeoutSeconds: 5

            failureThreshold: 30

          lifecycle:

            postStart:

              exec:

                command:

                  - /bin/sh

                  - -c

                  - |

                    echo "Frontend started successfully."

            preStop:

              exec:

                command:

                  - /bin/sh

                  - -c

                  - |

                    echo "Gracefully shutting down frontend..."

                    sleep 10

      terminationGracePeriodSeconds: 30

      restartPolicy: Always

      dnsPolicy: ClusterFirst

      nodeSelector:

{{ include "ai-platform.nodeSelector" . | indent 8 }}

      affinity:

{{ include "ai-platform.affinity" . | indent 8 }}

      tolerations:

{{ include "ai-platform.tolerations" . | indent 8 }}

{{- with .Values.topologySpreadConstraints }}

      topologySpreadConstraints:

{{ include "ai-platform.topologySpreadConstraints" . | indent 8 }}

{{- end }}

{{- if .Values.frontend.initContainers.enabled }}

      initContainers:

        - name: wait-for-backend

          image: {{ .Values.frontend.initContainers.image | default "busybox:1.36" }}

          command:

            - sh

            - -c

            - |

              until nc -z {{ include "ai-platform.backend.service" . }} 8000; do
                echo "Waiting for backend..."
                sleep 2
              done

{{- end }}

{{- if .Values.frontend.podDisruptionBudget.enabled }}

---
apiVersion: policy/v1
kind: PodDisruptionBudget

metadata:

  name: {{ include "ai-platform.frontend.service" . }}-pdb

  namespace: {{ include "ai-platform.namespace" . }}

  labels:

{{ include "ai-platform.labels" . | indent 4 }}

spec:

  minAvailable: {{ .Values.frontend.podDisruptionBudget.minAvailable | default 1 }}

  selector:

    matchLabels:

{{ include "ai-platform.selectorLabels" . | indent 6 }}

      app.kubernetes.io/component: frontend

{{- end }}