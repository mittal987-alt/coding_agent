# Dockerfile.frontend
# ============================================================
# AI Software Engineer Frontend
# Production Next.js Container
# ============================================================

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci


# ------------------------------------------------------------
# Build
# ------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY frontend .

RUN npm run build


# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
FROM node:22-alpine

LABEL maintainer="AI Software Engineer"

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

RUN apk add --no-cache \
    tini \
    curl

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.* ./

RUN addgroup -S frontend && \
    adduser -S frontend -G frontend

RUN chown -R frontend:frontend /app

USER frontend

EXPOSE 3000

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

ENTRYPOINT ["/sbin/tini","--"]

# FIX: CMD's JSON array was previously split across multiple lines
# without line-continuation backslashes, causing Docker to read each
# item as a new (invalid) instruction:
#   "unknown instruction: "npm","
# Putting the whole array on a single line fixes this.
CMD ["npm", "run", "start"]