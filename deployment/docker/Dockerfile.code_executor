# Dockerfile.code_executor
# ============================================================
# AI Software Engineer
# Secure Code Execution Sandbox
# ============================================================

FROM python:3.12-slim

LABEL maintainer="AI Software Engineer"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /executor

# ------------------------------------------------------------
# Install System Packages
# ------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y \
        tini \
        git \
        curl \
        gcc \
        g++ \
        make \
        nodejs \
        npm \
        openjdk-21-jdk-headless \
        golang \
        rustc \
        cargo \
        && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Python Dependencies
# ------------------------------------------------------------
COPY backend/requirements-executor.txt .

RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    -r requirements-executor.txt

# ------------------------------------------------------------
# Copy Executor
# ------------------------------------------------------------
COPY backend/app/executor ./executor

# ------------------------------------------------------------
# Sandbox User
# ------------------------------------------------------------
RUN addgroup --system sandbox && \
    adduser \
        --system \
        --ingroup sandbox \
        sandbox

RUN mkdir -p \
        /workspace \
        /tmp/execution \
        /logs && \
    chown -R sandbox:sandbox \
        /workspace \
        /tmp/execution \
        /logs \
        /executor

USER sandbox

# ------------------------------------------------------------
# Resource Limits
# ------------------------------------------------------------
ENV EXECUTION_TIMEOUT=60
ENV MAX_MEMORY_MB=2048
ENV MAX_CPU_TIME=30
ENV MAX_FILE_SIZE_MB=100
ENV MAX_PROCESSES=50

WORKDIR /workspace

# ------------------------------------------------------------
# Healthcheck
# ------------------------------------------------------------
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --retries=3 \
CMD python -c "print('healthy')" || exit 1

ENTRYPOINT ["/usr/bin/tini","--"]

CMD [
    "python",
    "/executor/executor/main.py"
]