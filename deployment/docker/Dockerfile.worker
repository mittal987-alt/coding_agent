# Dockerfile.worker
# ============================================================
# AI Software Engineer Worker
# Background Worker / Celery / Queue Processor
# ============================================================

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update && \
    apt-get install -y \
        build-essential \
        gcc \
        git \
        curl && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .

RUN pip install --upgrade pip

RUN pip wheel \
    --wheel-dir=/wheels \
    -r requirements.txt


# ============================================================
# Runtime
# ============================================================

FROM python:3.12-slim

LABEL maintainer="AI Software Engineer"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y \
        git \
        curl \
        tini && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /wheels /wheels

COPY backend/requirements.txt .

RUN pip install \
    --no-cache \
    /wheels/*

COPY backend .

RUN addgroup --system worker && \
    adduser --system \
        --ingroup worker \
        worker

RUN mkdir -p \
        /var/log/worker \
        /tmp/worker && \
    chown -R worker:worker \
        /app \
        /var/log/worker \
        /tmp/worker

USER worker

ENV CELERY_BROKER_URL=redis://redis:6379/0
ENV CELERY_RESULT_BACKEND=redis://redis:6379/1

HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=30s \
    --retries=3 \
CMD python -c "import os, redis; redis.from_url(os.environ.get('CELERY_BROKER_URL', 'redis://redis:6379/0')).ping()" || exit 1

ENTRYPOINT ["/usr/bin/tini","--"]

CMD ["celery","-A","app.worker.celery_app","worker","--loglevel=INFO","--concurrency=4","--prefetch-multiplier=1","--max-tasks-per-child=100"]