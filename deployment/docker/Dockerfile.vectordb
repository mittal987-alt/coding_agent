# Dockerfile.vectordb
# ============================================================
# AI Software Engineer
# Vector Database (Qdrant)
# Production Dockerfile
# ============================================================

FROM qdrant/qdrant:v1.13.4

LABEL maintainer="AI Software Engineer"

ENV QDRANT__SERVICE__HTTP_PORT=6333
ENV QDRANT__SERVICE__GRPC_PORT=6334

ENV QDRANT__STORAGE__STORAGE_PATH=/qdrant/storage
ENV QDRANT__STORAGE__SNAPSHOTS_PATH=/qdrant/snapshots
ENV QDRANT__STORAGE__TEMP_PATH=/qdrant/temp

ENV QDRANT__LOG_LEVEL=INFO

RUN mkdir -p \
    /qdrant/storage \
    /qdrant/snapshots \
    /qdrant/temp \
    /qdrant/config

COPY deployment/qdrant/config.yaml \
    /qdrant/config/config.yaml

VOLUME [
    "/qdrant/storage",
    "/qdrant/snapshots"
]

EXPOSE 6333
EXPOSE 6334

HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=30s \
    --retries=3 \
CMD wget --quiet \
    --spider \
    http://localhost:6333/healthz || exit 1

CMD [
    "./qdrant",
    "--config-path",
    "/qdrant/config/config.yaml"
]